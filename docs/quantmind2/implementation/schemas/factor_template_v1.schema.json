{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantmind.local/schemas/factor_template_v1.schema.json",
  "title": "QuantMind Factor Template DSL v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "description", "dataset_kinds", "parameters", "expression", "output"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "name": {"$ref": "#/$defs/name"},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "dataset_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "parameters": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/parameterDefinition"}},
    "expression": {"$ref": "#/$defs/node"},
    "output": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"$ref": "#/$defs/name"}}}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
    "finiteNumber": {"type": "number"},
    "parameterDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type", "default", "minimum", "maximum"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "type": {"enum": ["integer", "number"]}, "default": {"$ref": "#/$defs/finiteNumber"}, "minimum": {"$ref": "#/$defs/finiteNumber"}, "maximum": {"$ref": "#/$defs/finiteNumber"}, "step": {"$ref": "#/$defs/finiteNumber"}}
    },
    "node": {"oneOf": [
      {"$ref": "#/$defs/namedTerminal"}, {"$ref": "#/$defs/constant"},
      {"$ref": "#/$defs/binary"}, {"$ref": "#/$defs/unary"}, {"$ref": "#/$defs/clip"},
      {"$ref": "#/$defs/periodic"}, {"$ref": "#/$defs/rolling"},
      {"$ref": "#/$defs/rollingCorrelation"}, {"$ref": "#/$defs/rollingQuantile"}
    ]},
    "namedTerminal": {"type": "object", "additionalProperties": false, "required": ["type", "name"], "properties": {"type": {"enum": ["feature", "parameter"]}, "name": {"$ref": "#/$defs/name"}}},
    "constant": {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "constant"}, "value": {"$ref": "#/$defs/finiteNumber"}}},
    "binary": {"type": "object", "additionalProperties": false, "required": ["type", "left", "right"], "properties": {"type": {"enum": ["add", "subtract", "multiply", "divide"]}, "left": {"$ref": "#/$defs/node"}, "right": {"$ref": "#/$defs/node"}}},
    "unary": {"type": "object", "additionalProperties": false, "required": ["type", "operand"], "properties": {"type": {"enum": ["negate", "absolute", "cs_rank", "cs_zscore"]}, "operand": {"$ref": "#/$defs/node"}}},
    "clip": {"type": "object", "additionalProperties": false, "required": ["type", "operand", "lower", "upper"], "properties": {"type": {"const": "clip"}, "operand": {"$ref": "#/$defs/node"}, "lower": {"$ref": "#/$defs/node"}, "upper": {"$ref": "#/$defs/node"}}},
    "periodic": {"type": "object", "additionalProperties": false, "required": ["type", "operand", "periods"], "properties": {"type": {"enum": ["lag", "delta"]}, "operand": {"$ref": "#/$defs/node"}, "periods": {"$ref": "#/$defs/node"}}},
    "rolling": {"type": "object", "additionalProperties": false, "required": ["type", "operand", "window"], "properties": {"type": {"enum": ["rolling_mean", "rolling_std", "rolling_min", "rolling_max", "rolling_sum", "rolling_median", "rolling_skew", "rolling_argmax_age"]}, "operand": {"$ref": "#/$defs/node"}, "window": {"$ref": "#/$defs/node"}}},
    "rollingCorrelation": {"type": "object", "additionalProperties": false, "required": ["type", "left", "right", "window"], "properties": {"type": {"const": "rolling_corr"}, "left": {"$ref": "#/$defs/node"}, "right": {"$ref": "#/$defs/node"}, "window": {"$ref": "#/$defs/node"}}},
    "rollingQuantile": {"type": "object", "additionalProperties": false, "required": ["type", "operand", "window", "quantile"], "properties": {"type": {"const": "rolling_quantile"}, "operand": {"$ref": "#/$defs/node"}, "window": {"$ref": "#/$defs/node"}, "quantile": {"$ref": "#/$defs/node"}}}
  }
}
