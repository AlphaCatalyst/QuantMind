{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://quantmind.local/schemas/current_state_v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source_commit", "source_paths", "authority_level", "freshness_status", "verification_status", "architecture_version", "current_task", "latest_implementation_run", "components_by_status", "next_task_candidates"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "generated_at": {"type": "string"}, "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_paths": {"type": "array", "items": {"type": "string"}}, "authority_level": {"const": "derived_summary"},
    "freshness_status": {"enum": ["current_at_base_commit", "stale", "unknown"]}, "verification_status": {"enum": ["verified", "partial", "unverified"]},
    "architecture_version": {"const": "v1"}, "current_task": {"type": "string"}, "latest_implementation_run": {"type": "string"},
    "components_by_status": {"type": "object", "required": ["implemented", "partial", "planned", "not_implemented", "deprecated", "blocked"], "additionalProperties": false, "properties": {"implemented": {"type": "array", "items": {"type": "string"}}, "partial": {"type": "array", "items": {"type": "string"}}, "planned": {"type": "array", "items": {"type": "string"}}, "not_implemented": {"type": "array", "items": {"type": "string"}}, "deprecated": {"type": "array", "items": {"type": "string"}}, "blocked": {"type": "array", "items": {"type": "string"}}}},
    "next_task_candidates": {"type": "array", "items": {"enum": ["QM2-P0-002", "QM2-P0-002A1", "QM2-P0-002A2b", "QM2-P0-002A3", "QM2-P0-002B", "QM2-P0-003", "QM2-P0-003F", "QM2-P0-004"]}}
  }
}
