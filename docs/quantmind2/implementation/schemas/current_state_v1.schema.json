{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://quantmind.local/schemas/current_state_v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source_commit", "source_paths", "authority_level", "freshness_status", "verification_status", "architecture_version", "current_task", "latest_implementation_run", "current_canonical_registry_snapshot_id", "components_by_status", "next_task_candidates"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "generated_at": {"type": "string"}, "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_paths": {"type": "array", "items": {"type": "string"}}, "authority_level": {"const": "derived_summary"},
    "freshness_status": {"enum": ["current_at_base_commit", "stale", "unknown"]}, "verification_status": {"enum": ["verified", "partial", "unverified"]},
    "architecture_version": {"const": "v1"}, "current_task": {"type": "string"}, "latest_implementation_run": {"type": "string"},
    "current_canonical_registry_snapshot_id": {"type": "string", "pattern": "^(frs|trg)_[0-9a-f]{64}$"},
    "components_by_status": {"type": "object", "required": ["implemented", "partial", "planned", "not_implemented", "deprecated", "blocked"], "additionalProperties": false, "properties": {"implemented": {"type": "array", "items": {"type": "string"}}, "partial": {"type": "array", "items": {"type": "string"}}, "planned": {"type": "array", "items": {"type": "string"}}, "not_implemented": {"type": "array", "items": {"type": "string"}}, "deprecated": {"type": "array", "items": {"type": "string"}}, "blocked": {"type": "array", "items": {"type": "string"}}}},
    "fresh_validation": {"type": "object", "additionalProperties": false,
      "required": ["candidate_lock_id", "protocol_id", "exposure_ledger_id", "watermark_id", "status", "eligible_date_count", "real_evaluation_executed"],
      "properties": {"candidate_lock_id": {"type": "string", "pattern": "^fvcl_[0-9a-f]{64}$"}, "protocol_id": {"type": "string", "pattern": "^fvp_[0-9a-f]{64}$"}, "exposure_ledger_id": {"type": "string", "pattern": "^rdel_[0-9a-f]{64}$"}, "watermark_id": {"type": "string", "pattern": "^fdw_[0-9a-f]{64}$"}, "status": {"enum": ["awaiting_first_fresh_date", "collecting", "mature", "evaluated", "blocked"]}, "eligible_date_count": {"type": "integer", "minimum": 0}, "real_evaluation_executed": {"type": "boolean"}}},
    "strategy_layer": {"type": "object", "additionalProperties": false,
      "required": ["unified_signal_id", "strategy_registry_id", "backtest_completed_count", "approved_count", "active_count", "fixed_100_benchmark_canonicality"],
      "properties": {"unified_signal_id": {"type": "string", "pattern": "^usa_[0-9a-f]{64}$"}, "strategy_registry_id": {"type": "string", "pattern": "^srr_[0-9a-f]{64}$"}, "backtest_completed_count": {"type": "integer", "minimum": 0}, "approved_count": {"const": 0}, "active_count": {"const": 0}, "fixed_100_benchmark_canonicality": {"const": "noncanonical"}}},
    "autonomous_research_cycle_002": {"type": "object", "additionalProperties": false,
      "required": ["operator_extension_id", "primitive_catalog_id", "feature_catalog_v3_id", "research_cycle_id", "new_research_feature_count", "retrospective_candidate_count", "fresh_lock_count", "status"],
      "properties": {"operator_extension_id": {"type": "string", "pattern": "^tdoe1_[0-9a-f]{64}$"}, "primitive_catalog_id": {"type": "string", "pattern": "^tpc2_[0-9a-f]{64}$"}, "feature_catalog_v3_id": {"type": "string", "pattern": "^tfc3_[0-9a-f]{64}$"}, "research_cycle_id": {"type": "string", "pattern": "^arc2_[0-9a-f]{64}$"}, "new_research_feature_count": {"const": 20}, "retrospective_candidate_count": {"const": 0}, "fresh_lock_count": {"const": 0}, "status": {"const": "waiting_for_fresh_data_or_novel_space"}}},
    "next_task_candidates": {"type": "array", "items": {"enum": ["QM2-P0-002", "QM2-P0-002A1", "QM2-P0-002A2b", "QM2-P0-002A3", "QM2-P0-002B", "QM2-P0-003", "QM2-P0-003F", "QM2-P0-004", "QM2-P0-005", "QM2-P0-006", "QM2-P0-007", "QM2-P0-008", "QM2-P0-008F", "QM2-P0-009", "QM2-P0-010", "QM2-P0-011", "QM2-P0-011B", "QM2-P0-012", "QM2-P0-012F", "QM2-P0-014", "QM2-P0-015", "QM2-P0-017", "QM2-P0-018", "QM2-R1-002"]}}
  }
}
