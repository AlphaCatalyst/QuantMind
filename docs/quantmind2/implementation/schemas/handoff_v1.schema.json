{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://quantmind.local/schemas/handoff_v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source_commit", "source_paths", "authority_level", "freshness_status", "verification_status", "repository", "branch", "base_commit", "workspace_dirty", "unrelated_dirty_files", "factor_lab_source", "architecture_version", "current_task", "completion_status", "latest_implementation_run", "next_recommended_tasks", "unconfirmed_facts", "protected_constraints", "mandatory_read_order", "uncommitted_work"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "generated_at": {"type": "string"}, "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_paths": {"type": "array", "items": {"type": "string"}}, "authority_level": {"const": "derived_handoff"},
    "freshness_status": {"enum": ["current_at_base_commit", "stale", "unknown"]}, "verification_status": {"enum": ["verified", "partial", "unverified"]},
    "repository": {"type": "string"}, "branch": {"type": "string"}, "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "workspace_dirty": {"type": "boolean"}, "unrelated_dirty_files": {"type": "array", "items": {"type": "string"}},
    "factor_lab_source": {"type": "object", "additionalProperties": false, "required": ["root", "source_path", "branch", "commit", "read_only"], "properties": {"root": {"type": "string"}, "source_path": {"type": "string"}, "branch": {"type": "string"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "read_only": {"const": true}}},
    "architecture_version": {"const": "v1"}, "current_task": {"type": "string"}, "completion_status": {"enum": ["completed_uncommitted", "completed_committed", "partial_uncommitted", "blocked", "in_progress"]},
    "latest_implementation_run": {"type": "string"}, "next_recommended_tasks": {"type": "array", "items": {"enum": ["QM2-P0-002", "QM2-P0-002A1", "QM2-P0-002A2b", "QM2-P0-002A3", "QM2-P0-003"]}},
    "unconfirmed_facts": {"type": "array", "items": {"type": "string"}}, "protected_constraints": {"type": "array", "items": {"type": "string"}},
    "mandatory_read_order": {"type": "array", "minItems": 8, "items": {"type": "string"}}, "uncommitted_work": {"type": "boolean"}
  }
}
