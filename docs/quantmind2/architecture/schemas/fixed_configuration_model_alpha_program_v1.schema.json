{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantmind.local/schemas/fixed_configuration_model_alpha_program_v1.schema.json",
  "title": "QuantMind Fixed Configuration Model Alpha Program v1",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/fixedConfigurationModelSpec"},
    {"$ref": "#/$defs/modelFeatureBundleSpec"},
    {"$ref": "#/$defs/purgedWalkForwardSpec"},
    {"$ref": "#/$defs/modelFoldResult"},
    {"$ref": "#/$defs/modelStabilityAssessment"},
    {"$ref": "#/$defs/retrospectiveModelCandidate"}
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["schema_version", "provider_id", "promotion_writes"],
      "properties": {
        "provider_id": {"const": "tushare-pro-v1"},
        "promotion_writes": {"const": 0}
      }
    },
    "fixedConfigurationModelSpec": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "required": ["model_spec_id", "model_type", "label_name", "seeds", "parameters"],
          "properties": {
            "schema_version": {"const": "fixed-configuration-model-spec-v1"},
            "model_spec_id": {"type": "string", "pattern": "^fcms1_[a-f0-9]{64}$"},
            "model_type": {"const": "lightgbm"},
            "label_name": {"const": "model_label"},
            "seeds": {"const": [20260701, 20260702, 20260703]},
            "parameters": {"type": "object"}
          }
        }
      ]
    },
    "modelFeatureBundleSpec": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "required": ["bundle_id", "bundle_name", "candidate_feature_names", "frozen_before_training"],
          "properties": {
            "schema_version": {"const": "model-feature-bundle-spec-v1"},
            "bundle_id": {"type": "string", "pattern": "^mfbs1_[a-f0-9]{64}$"},
            "bundle_name": {
              "enum": [
                "existing_technical_core",
                "expanded_technical_space",
                "combined_decorrelated_technical"
              ]
            },
            "candidate_feature_names": {"type": "array", "minItems": 1, "uniqueItems": true},
            "frozen_before_training": {"const": true}
          }
        }
      ]
    },
    "purgedWalkForwardSpec": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "required": ["walk_forward_spec_id", "purge_sessions", "folds"],
          "properties": {
            "schema_version": {"const": "purged-walk-forward-spec-v1"},
            "walk_forward_spec_id": {"type": "string", "pattern": "^pwfs1_[a-f0-9]{64}$"},
            "purge_sessions": {"type": "integer", "minimum": 10},
            "folds": {"type": "array", "minItems": 4, "maxItems": 4}
          }
        }
      ]
    },
    "modelFoldResult": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "required": ["fold_result_id", "fold_id", "metrics", "selected_features"],
          "properties": {
            "schema_version": {"const": "model-fold-result-v1"},
            "fold_result_id": {"type": "string", "pattern": "^mfr1_[a-f0-9]{64}$"},
            "fold_id": {"type": "string"},
            "metrics": {"type": "object"},
            "selected_features": {"type": "array", "minItems": 1}
          }
        }
      ]
    },
    "modelStabilityAssessment": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "required": ["stability_assessment_id", "feature_importance", "seed_stability", "fold_stability"],
          "properties": {
            "schema_version": {"const": "model-stability-assessment-v1"},
            "stability_assessment_id": {"type": "string", "pattern": "^msa1_[a-f0-9]{64}$"}
          }
        }
      ]
    },
    "retrospectiveModelCandidate": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "required": ["candidate_id", "status", "worth_fresh_observation", "annual_metrics"],
          "properties": {
            "schema_version": {"const": "retrospective-model-candidate-v1"},
            "candidate_id": {"type": "string", "pattern": "^rmc1_[a-f0-9]{64}$"},
            "status": {"const": "retrospective_model_candidate"},
            "worth_fresh_observation": {"const": true}
          }
        }
      ]
    }
  }
}
